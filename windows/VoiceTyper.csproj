<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>VoiceTyper</AssemblyName>
    <RootNamespace>VoiceTyper</RootNamespace>
    <!-- 版本号与 macOS 对齐：3.5.0 = 对齐 macOS 3.5.0 的行为基线（首启引导、切换式热键、就绪反馈、
         HUD 反馈组、输入设备策略、单独修饰键热键、LLM 关闭深度思考、分段下载、耗时度量，
         详见 CHANGELOG.md），并首次在带 SDK 的环境里真实编译、跑通测试与两个 RID 的发布。 -->
    <Version>3.5.1</Version>
    <AssemblyVersion>3.5.1.0</AssemblyVersion>
    <FileVersion>3.5.1.0</FileVersion>
    <Company>VoiceTyper</Company>
    <Product>VoiceTyper</Product>
    <Description>VoiceTyper —— 前后端一体的离线语音输入工具（Windows 原生，内嵌 SenseVoice-Small 识别引擎）</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 目录式部署（见 windows/DESIGN.md §7 D9）：不启用 PublishSingleFile —— 一个常驻自启的
         菜单栏工具不该在每个新版本首启时把 14MB 的 onnxruntime.dll 解压到 %TEMP%，
         这既拖慢启动又是 AV 误报高发路径。build.bat 用普通 dotnet publish 产出目录，
         Inno Setup 负责打成单文件安装包。 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- WinForms 依赖内建 COM 封送，SDK 当前不支持对此应用类型做 IL 裁剪。 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 使用目标架构的 .NET 10 Desktop Runtime，不把共享运行时重复装进应用目录。 -->
    <SelfContained>false</SelfContained>
    <!-- ReadyToRun：开机自启的常驻工具，登录后第一次按热键要先把 WinForms、托盘、热键钩子、ONNX 封装这些路径
         全部 JIT 一遍。预编译换掉这部分启动开销，代价是发布目录里这几个托管程序集变大（体积见
         PACKAGE_SIZE_AUDIT.md）。只在 publish 时生效，build / 测试不受影响。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 英文资源为框架的默认资源；应用仅提供中文和英文界面。 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 调试符号保留在构建目录，不随面向用户的发布包分发。 -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- WFO0003 建议把 DPI 声明挪出 app.manifest。这里刻意保留 manifest 声明：它在任何代码运行之前就生效，
         比 Application.SetHighDpiMode 更可靠（后者必须赶在第一个窗口之前调用）；Program.cs 里的调用只是双保险。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 macos/ 钉的版本一致，消掉"不同 ORT 版本导致 argmax 翻转"这一整类变量。
         升级 ORT 应作为一次独立的、带金标准复测的变更。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.2" />
    <!-- 仅用 WASAPI 采集及其传递依赖 NAudio.Core，不引入 ASIO、MIDI、WinMM 与音频 UI。 -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试源码单独属于 Tests/VoiceTyper.Tests 工程；SDK 默认 glob 会把它编进主工程，
         而主工程不引用 xUnit（R0-1）。首轮用局部排除把变更面压到最小。 -->
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\correction.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 原生导入库只用于链接原生代码，C# 应用运行只需要对应 DLL。 -->
  <Target Name="ExcludeNativeImportLibrariesFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.lib'" />
    </ItemGroup>
  </Target>
</Project>
