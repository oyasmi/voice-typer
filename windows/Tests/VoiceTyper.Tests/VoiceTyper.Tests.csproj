<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>VoiceTyper.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VoiceTyper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用 macos/ 已入库的金标准夹具：两个平台的 fbank 实现共用同一份 Python 参考输出，
         不需要各自造一遍。缺失（未 checkout 到该子目录，或未来被移走）时用 Condition 跳过，
         对应测试内部再用 Skip 兜底。 -->
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\fbank_input.f32"
          Link="Fixtures\fbank_input.f32" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\macos\Tests\VoiceTyperTests\Fixtures\fbank_input.f32')" />
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\fbank_reference.f32"
          Link="Fixtures\fbank_reference.f32" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\macos\Tests\VoiceTyperTests\Fixtures\fbank_reference.f32')" />
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\lfrcmvn_reference.f32"
          Link="Fixtures\lfrcmvn_reference.f32" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\macos\Tests\VoiceTyperTests\Fixtures\lfrcmvn_reference.f32')" />
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\speech_zh_en_mixed.wav"
          Link="Fixtures\speech_zh_en_mixed.wav" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\macos\Tests\VoiceTyperTests\Fixtures\speech_zh_en_mixed.wav')" />
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\speech_zh_en_mixed.reference.txt"
          Link="Fixtures\speech_zh_en_mixed.reference.txt" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\macos\Tests\VoiceTyperTests\Fixtures\speech_zh_en_mixed.reference.txt')" />
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\fbank_parity_shapes.json"
          Link="Fixtures\fbank_parity_shapes.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\macos\Tests\VoiceTyperTests\Fixtures\fbank_parity_shapes.json')" />
    <!-- R8-F2「中英文之间统一加空格」的共享用例：macOS 与 Windows 的 OutputFormatter 读同一份，
         两平台规则只能一起改。不同于上面的金标准，这份是必需的——缺失时测试直接失败，而不是跳过。 -->
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\text_format_cases.json"
          Link="Fixtures\text_format_cases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 自定义词汇（VOC-7 替换层、VOC-5 束搜索）的共享用例，规则见 macos/docs/VOCABULARY_SPEC.md。同样是必需夹具。 -->
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\vocabulary_cases.json"
          Link="Fixtures\vocabulary_cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\macos\Tests\VoiceTyperTests\Fixtures\ctc_hotword_cases.json"
          Link="Fixtures\ctc_hotword_cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
